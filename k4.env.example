# kindle4ever settings. Copy to k4.env (gitignored) or anywhere you like and point
# K4_ENV at it; real environment variables override the file.

# Kindle's IP on your Wi-Fi (tools/find-kindle.* fills this in for you).
K4_HOST=192.168.1.50
# Kindle's Wi-Fi MAC (Menu > Settings > page 2 > Device Info) and your LAN's first three octets.
K4_MAC=AA:BB:CC:DD:EE:FF
K4_SUBNET=192.168.1
# SSH key for root on the Kindle (RSA: the device's old dropbear has no ed25519).
#   ssh-keygen -t rsa -b 2048 -f ~/.ssh/kindle4ever
K4_SSH_KEY=~/.ssh/kindle4ever
# Optional:
# K4_KNOWN_HOSTS=~/.ssh/kindle4ever_known_hosts   (default: <devkit>/.known_hosts)
# K4_VENDOR=/path/to/vendor                     (default: <devkit>/vendor)
# K4_ZIG=/path/to/zig                           (default: toolchain/zig, then PATH)
# K4_DEVICE_DIR=/mnt/us/kindle4ever                    (where the devkit lives on the Kindle)
# K4_LEAKLIST=/path/outside/repo/leakcheck.txt  (your exact private values, for check-public.sh)
