#!/bin/sh
# Simulated lipc-set-prop: records the value in $K4_SIM/state and logs it. (powerd rtcWakeup is accepted silently.)
SIM=${K4_SIM:-build/sim}; S=$SIM/state
[ "$1" = "-i" ] || [ "$1" = "-s" ] && shift
src=${1#com.lab126.}; k="$src.$2"; v=$3
touch "$S"; grep -v "^$k=" "$S" > "$S.tmp" 2>/dev/null; echo "$k=$v" >> "$S.tmp"; mv "$S.tmp" "$S"
echo "$(date +%H:%M:%S) lipc-set-prop $1 $2 $3" >> "$SIM/run.log"
