#!/bin/sh
# Simulated k4keys: keys come from the viewer's queue file ($K4_SIM/keys.txt, one "name hold_ms" per line).
# Same interface as the real tool: -1 (one press, print its name), -t SECONDS, -g (ignored), stream mode otherwise.
SIM=${K4_SIM:-build/sim}; Q=$SIM/keys.txt
one=0; timeout=0
while [ $# -gt 0 ]; do case "$1" in -1) one=1 ;; -t) shift; timeout=$1 ;; -g) ;; esac; shift; done
pop() {  # -> $name $hold, or 1 if the queue is empty
  [ -s "$Q" ] || return 1
  line=$(head -n 1 "$Q"); tail -n +2 "$Q" > "$Q.tmp" && mv "$Q.tmp" "$Q"
  name=${line%% *}; hold=${line#* }; [ "$hold" = "$line" ] && hold=0
  [ -n "$name" ]
}
start=$(date +%s); t0=$(date +%s%N 2>/dev/null || echo 0)
while :; do
  if pop; then
    ms=$(( ($(date +%s%N 2>/dev/null || echo 0) - t0) / 1000000 ))
    if [ $one = 1 ]; then echo "$name"; exit 0; fi
    echo "$name down 0:0 $ms"
    [ "$hold" -gt 0 ] 2>/dev/null && sleep "$(awk -v h="$hold" 'BEGIN{printf "%.2f", h/1000}')"
    echo "$name up 0:0 $((ms + hold))"
  else
    [ "$timeout" -gt 0 ] 2>/dev/null && [ $(( $(date +%s) - start )) -ge "$timeout" ] && exit 1
    sleep 0.1
  fi
done
